# ==============================================================================
# proptii-backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Cosmos DB (SQL API) ────────────────────────────────────────────────────────
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE_NAME=proptii-db
COSMOS_DB_CONTAINER=Properties

# ── Azure Storage (for property document uploads) ──────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_SAS_TOKEN=

# ── Email Service (SMTP or Resend) ─────────────────────────────────────────────
# Set to 'noreply@mail.proptii.co' or similar approved email domain
EMAIL_FROM_ADDRESS=
SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
RESEND_API_KEY=

# ── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ── Firebase Admin SDK (real-time notifications/messaging) ────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Azure AD B2C / MSAL (for JWT validation) ───────────────────────────────────
# Policy base URL only — no /v2.0/ suffix (the API appends it for issuer + JWKS).
# Must match the frontend: same tenant and user flow as VITE_AZURE_AD_* (see src/config/authConfig.ts).
# MSAL_CLIENT_ID should match the SPA app registration (VITE_AZURE_AD_CLIENT_ID), not necessarily AZURE_AD_B2C_CLIENT_ID used for server-only APIs.
MSAL_AUTHORITY=https://proptii.b2clogin.com/proptii.onmicrosoft.com/B2C_1_SignUpandSignInProptii
MSAL_CLIENT_ID=
MSAL_REDIRECT_URI=
# Optional: comma-separated extra `aud` values if B2C issues tokens with an app ID URI instead of the raw client GUID (decode token at jwt.ms and copy `aud`).
MSAL_ADDITIONAL_AUDIENCES=
# Optional: exact iss claim from an access token (jwt.ms). Only if you need strict issuer checks; B2C iss often differs from MSAL_AUTHORITY/v2.0.
JWT_EXPECTED_ISSUER=

# ── Frontend / CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ── MongoDB / Cosmos DB Mongo API ──────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=proptii-communication

# ── Test email (dev/staging only) ──────────────────────────────────────────────
# Used as fallback recipient for testing email endpoints.
TEST_EMAIL_RECIPIENT=