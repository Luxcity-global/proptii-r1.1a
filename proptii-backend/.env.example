# ==============================================================================
# proptii-backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Endpoint URL (https://<account>.documents.azure.com:443/) OR full
# AccountEndpoint=…;AccountKey=…; connection string. Do not pass the full
# connection string as endpoint while also using a mismatched COSMOS_DB_KEY.
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_KEY=
COSMOS_DB_NAME=
COSMOS_DB_CONTAINER=

SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=


# ── AI extraction (referencing auto-fill) ──────────────────────────────────────
# OpenRouter (Gemini) — supports PDF + images. Preferred for Auto-fill.
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemini-2.5-flash, then newer Flash models.
OPENROUTER_MODEL=
# Fallback: Azure OpenAI vision (images only; use gpt-4o / gpt-4o-mini).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
Azure_Client_ID=
Azure_AD_B2C_Tenant_Name=
Azure_AD_B2C_Client_ID_secret=
GOOGLE_SHEETS_API_ENDPOINT=


# ── Azure AD B2C / MSAL (for JWT validation) ───────────────────────────────────
# Policy base URL only — no /v2.0/ suffix (the API appends it for issuer + JWKS).
# Must match the frontend: same tenant and user flow as VITE_AZURE_AD_* (see src/config/authConfig.ts).
# MSAL_CLIENT_ID should match the SPA app registration (VITE_AZURE_AD_CLIENT_ID), not necessarily AZURE_AD_B2C_CLIENT_ID used for server-only APIs.
MSAL_AUTHORITY=
MSAL_CLIENT_ID=
# Optional: comma-separated extra `aud` values if B2C issues tokens with an app ID URI instead of the raw client GUID (decode token at jwt.ms and copy `aud`).
MSAL_ADDITIONAL_AUDIENCES=
# Optional: exact iss claim from an access token (jwt.ms). Only if you need strict issuer checks; B2C iss often differs from MSAL_AUTHORITY/v2.0.
JWT_EXPECTED_ISSUER=
MSAL_REDIRECT_URI=


# ── Frontend / CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ── Test email (dev/staging only) ──────────────────────────────────────────────
# Used as fallback recipient for the /referencing/test-email endpoint.
# Must be explicitly set — no personal email is ever hardcoded.
TEST_EMAIL_RECIPIENT=

# ── Stripe (billing module — Sprint 1+) ────────────────────────────────────────
# Use TEST keys in dev/staging. Live keys in production ONLY.
# Never commit real values to version control.
# Secret key from Stripe Dashboard → Developers → API keys (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from `stripe listen` or Dashboard → Webhooks (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_...

# Promo toggle — controls the 30-day free trial (expires 31 July 2026).
# true  = trial_period_days: 30 sent to Stripe + promo banner visible on /pricing.
# false = trial_period_days: 0 (omitted) + promo banner hidden. No redeploy needed.
PROMO_FREE_MONTH_ACTIVE=true

# Stripe Price IDs — Renters & Buyers
# Obtain from Stripe Dashboard → Products → select product → copy Price ID.
STRIPE_PRICE_RENTER_PRO_MONTHLY=price_...
STRIPE_PRICE_RENTER_PRO_ANNUAL=price_...
STRIPE_PRICE_BUYER_PRO_MONTHLY=price_...
STRIPE_PRICE_BUYER_PRO_ANNUAL=price_...

# Stripe Price IDs — Landlords
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_LANDLORD_PRO_MONTHLY=price_...
STRIPE_PRICE_LANDLORD_PRO_ANNUAL=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...
STRIPE_PRICE_ELITE_ANNUAL=price_...

# Stripe Price IDs — Estate Agents
STRIPE_PRICE_INDEPENDENT_MONTHLY=price_...
STRIPE_PRICE_INDEPENDENT_ANNUAL=price_...
STRIPE_PRICE_AGENT_PRO_MONTHLY=price_...
STRIPE_PRICE_AGENT_PRO_ANNUAL=price_...
# Note: Enterprise has no Stripe product (contact-sales flow only — §4.8).

