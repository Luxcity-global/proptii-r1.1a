# ==============================================================================
# proptii-backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_KEY=
COSMOS_DB_NAME=
COSMOS_DB_CONTAINER=

SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=


AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
Azure_Client_ID=
Azure_AD_B2C_Tenant_Name=
Azure_AD_B2C_Client_ID_secret=
GOOGLE_SHEETS_API_ENDPOINT=


# ── Azure AD B2C / MSAL (for JWT validation) ───────────────────────────────────
# e.g. https://proptii.b2clogin.com/proptii.onmicrosoft.com/B2C_1_signupsignin
MSAL_AUTHORITY=
MSAL_CLIENT_ID=
MSAL_REDIRECT_URI=


# ── Frontend / CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ── Test email (dev/staging only) ──────────────────────────────────────────────
# Used as fallback recipient for the /referencing/test-email endpoint.
# Must be explicitly set — no personal email is ever hardcoded.
TEST_EMAIL_RECIPIENT=