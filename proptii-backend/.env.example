# ==============================================================================
# proptii-backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Cosmos DB ──────────────────────────────────────────────────────────────────
# Required for primary database operations
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE_NAME=proptii-db

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
# Required for property search and extraction
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ── Azure Storage ──────────────────────────────────────────────────────────────
# Optional: Used for storing and serving referencing documents
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_SAS_TOKEN=

# ── Email Service (Azure Communication Services / SMTP) ────────────────────────
# Option 1: Azure Communication Services
EMAIL_SERVICE_ENDPOINT=
EMAIL_SERVICE_KEY=
EMAIL_FROM_ADDRESS=

# Option 2: Generic SMTP (e.g., SendGrid, Mailtrap)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Option 3: Resend
RESEND_API_KEY=

# ── Firebase (Admin SDK) ───────────────────────────────────────────────────────
# Optional: Used for Firestore-backed features
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Azure AD B2C / MSAL (Authentication) ───────────────────────────────────────
# MSAL: Used for JWT validation and frontend-facing auth
MSAL_CLIENT_ID=
MSAL_AUTHORITY=https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>
MSAL_REDIRECT_URI=http://localhost:3000/auth/callback

# Azure AD B2C (Direct Graph API): Used for admin/user management
AZURE_AD_B2C_CLIENT_ID=
AZURE_AD_B2C_CLIENT_SECRET=
AZURE_AD_B2C_TENANT_ID=

# ── Frontend / CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ── OpenRouter ─────────────────────────────────────────────────────────────────
# Alternative AI provider
OPENROUTER_API_KEY=

# ── Google Sheets (Legacy) ─────────────────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ── Test email (Dev/Staging only) ──────────────────────────────────────────────
# Used as fallback recipient for testing endpoints
TEST_EMAIL_RECIPIENT=