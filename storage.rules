rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Referencing documents folder
    match /referencing_documents/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024; // 15MB limit
    }
    
    // Contracts folder - allow public read for shared viewing, write with 15MB limit
    match /contracts/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024;
    }
    
    // Properties folder
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024;
    }
    
    // General documents folder
    match /documents/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024;
    }
    
    // All other paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.size < 15 * 1024 * 1024;
    }
  }
}
