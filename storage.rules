rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Contracts folder — public read so tenants can open files sent by landlords.
    // Writes do not require Firebase Auth because the app uses Azure AD B2C.
    match /contracts/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }
    
    // Properties folder - allow public read, authenticated write (for development)
    match /properties/{allPaths=**} {
      allow read: if true; // Public read access
      // For development: allow writes without auth (remove in production)
      allow write: if true; // TODO: Change to `request.auth != null` in production
      // allow write: if request.auth != null && 
      //              request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    // Other files - maintain existing rules
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
