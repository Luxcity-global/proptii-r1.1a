# =============================================================================
# PROPTII BACKEND — Render Production Environment Template
# File: .env.production.backend
# =============================================================================

NODE_ENV=production
NODE_VERSION=20.11.1
PORT=10000

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=proptii-16946
# Paste your raw single-line JSON service account or refresh token here in Render Environment Tab
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"proptii-16946","private_key_id":"...","private_key":"...","client_email":"..."}'

# ─── Email — Resend (Primary) ─────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=noreply@mail.proptii.co

# ─── Email — SMTP Fallback ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contactus@theluxcity.co.uk
SMTP_PASS=...
SMTP_FROM_EMAIL=contactus@theluxcity.co.uk
SUPPORT_EMAIL=contactus@theluxcity.co.uk

# ─── MongoDB (Scraped listings database) ──────────────────────────────────────
MONGODB_URI=mongodb+srv://miracle:...@proptii.o9zltfe.mongodb.net/
MONGODB_DB_NAME=proptii-communication

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
BLOB_STORAGE_CONNECTION_STRING=BlobEndpoint=https://proptiir11a.blob.core.windows.net/...
BLOB_STORAGE_CONTAINER_NAME=message-attachments
AZURE_STORAGE_ACCOUNT_NAME=proptiir11a
AZURE_STORAGE_CONTAINER_NAME=property-documents-landlord-agent
AZURE_STORAGE_SAS_TOKEN=...

# ─── CORS & Origin Settings ───────────────────────────────────────────────────
API_PREFIX=/api
ALLOWED_ORIGINS=https://proptii-r1-1a-2.onrender.com,https://proptii.co,https://www.proptii.co
FRONTEND_URL=https://proptii-r1-1a-2.onrender.com
APP_URL=https://proptii-r1-1a-2.onrender.com

# ─── Stripe Payments (Server-side Keys) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_RENTER_PRO_MONTHLY=price_...
STRIPE_PRICE_RENTER_PRO_ANNUAL=price_...
STRIPE_PRICE_LANDLORD_PRO_MONTHLY=price_...
STRIPE_PRICE_LANDLORD_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENT_PRO_MONTHLY=price_...
STRIPE_PRICE_AGENT_PRO_ANNUAL=price_...
