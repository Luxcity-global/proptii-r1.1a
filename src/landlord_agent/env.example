# Azure AD Configuration
# Copy this file to .env and fill in your Azure AD app registration details

# Development Environment
REACT_APP_AZURE_CLIENT_ID_DEV=your-dev-client-id-here
REACT_APP_AZURE_AUTHORITY_DEV=https://login.microsoftonline.com/your-dev-tenant-id
REACT_APP_AZURE_REDIRECT_URI_DEV=http://localhost:5173

# Production Environment
REACT_APP_AZURE_CLIENT_ID_PROD=your-prod-client-id-here
REACT_APP_AZURE_AUTHORITY_PROD=https://login.microsoftonline.com/your-prod-tenant-id
REACT_APP_AZURE_REDIRECT_URI_PROD=https://your-production-domain.com

# Fallback Configuration (if environment-specific not provided)
REACT_APP_AZURE_CLIENT_ID=your-client-id-here
REACT_APP_AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
REACT_APP_AZURE_REDIRECT_URI=http://localhost:5173
REACT_APP_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
