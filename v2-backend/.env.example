# =============================================================================
# PROPTII v2-BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
# Used in: src/main.ts — NestJS listens on this port
PORT=3000

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# The app tries three credential strategies in this exact priority order:
#
# Strategy 1 (recommended for production — Render / cloud):
#   FIREBASE_SERVICE_ACCOUNT_JSON — paste the full contents of your service
#   account JSON as a single-line string. The app parses it at startup in
#   src/main.ts (initializeFirebase), src/config/firestore.config.ts
#   (initializeFirestore), and src/guards/firebase-auth.guard.ts.
#   Also accepts an OAuth2 refresh-token JSON (authorized_user type) — the app
#   writes it to a temp file and uses Application Default Credentials.
#
# Strategy 2 (alternative for production or CI):
#   FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY — individual service-account
#   fields. Used as fallback in all three files above when JSON is not set.
#
# Strategy 3 (development / emulator only):
#   FIREBASE_PROJECT_ID alone — app initialises in read-only / emulator mode.
#   Firestore writes will fail without real credentials.
#
# FIREBASE_PROJECT_ID is always read alongside whichever strategy is active
# to ensure the correct GCP project is targeted.

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Only needed if NOT using FIREBASE_SERVICE_ACCOUNT_JSON (Strategy 2)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Firebase Storage ─────────────────────────────────────────────────────────
# Used in: src/utils/firebase-storage.ts — all referencing document uploads.
# Files are stored at: referencing/{userId}/{section}/{field}/{uuid}.{ext}
# Uniform bucket-level access must be enabled (no per-object ACLs).
# Format: <project-id>.firebasestorage.app  OR  <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ─── Resend Email Service ─────────────────────────────────────────────────────
# Used in: src/utils/resend.ts — shared helper called by:
#   email.service.ts        → message notifications, claim emails, referencing share
#   contract.service.ts     → signed contract delivery (supports base64 PDF attachment)
#   referee-guarantor.service.ts → referee/guarantor request emails
# EMAIL_FROM_ADDRESS must be a verified sender domain in your Resend account.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@mail.proptii.co

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Used in: src/services/email.service.ts
# Base URL prepended to every link inside outgoing emails:
#   /login, /claim?token=..., /referencing/view/:token,
#   /claim-referencing?token=..., /landlord, /images/proptii-logo.png
FRONTEND_URL=http://localhost:5173

# ─── Referencing AI Document Extraction ───────────────────────────────────────
# Used in: src/services/referencing.service.ts — for document OCR & auto-fill
# Provide either GEMINI_API_KEY (recommended from https://aistudio.google.com/app/apikey)
# or OPENROUTER_API_KEY (from https://openrouter.ai/keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Keep-Alive (Render / Fly.io) ────────────────────────────────────────────
# Used in: src/main.ts — a setInterval pings GET /api/health every 4 minutes
# to prevent the Render free-tier instance from spinning down.
# RENDER_EXTERNAL_URL is set automatically by Render at runtime.
# Set BACKEND_URL manually if deploying elsewhere (e.g. Fly.io, Railway).
# If neither is set the ping targets http://127.0.0.1:<PORT> (harmless locally).
BACKEND_URL=https://your-backend-url.onrender.com

