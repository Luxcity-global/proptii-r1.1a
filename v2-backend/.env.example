# =============================================================================
# Consolidated v2 Backend — Environment Variables Template (.env.example)
# =============================================================================

PORT=3000
NODE_ENV=production

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=proptii-16946
# Provide raw JSON string or file path to service account key
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"proptii-16946"}'

# ─── Resend Email Service ─────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=noreply@mail.proptii.co

# ─── Stripe Payments (Production Secret Keys) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_RENTER_PRO_MONTHLY=price_...
STRIPE_PRICE_LANDLORD_PRO_MONTHLY=price_...

# ─── CORS Allowed Origins ─────────────────────────────────────────────────────
FRONTEND_URL=https://proptii.co
