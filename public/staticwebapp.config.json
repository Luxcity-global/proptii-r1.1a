{
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
  },
  "routes": [
    {
      "route": "/campaign*",
      "rewrite": "/campaign/index.html"
    },
    {
      "route": "/welcome*",
      "rewrite": "/welcome/index.html"
    },
    {
      "route": "/landlord*",
      "rewrite": "/landlord/index.html"
    },
    {
      "route": "/view-passport",
      "rewrite": "/index.html"
    },
    {
      "route": "/view-passport/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/referencing/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/claim-referencing",
      "rewrite": "/index.html"
    },
    {
      "route": "/claim-referencing/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/billing/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/signup/*",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/chunks/*",
      "/entries/*",
      "/images/*",
      "/landlord-app/assets/*",
      "/landlord-app/landlord-app/*",
      "/*.{css,js,ico,png,jpg,jpeg,gif,svg,woff,woff2}",
      "/403.html",
      "/500.html",
      "/rate-limit-exceeded.html"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}