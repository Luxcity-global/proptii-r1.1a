{
  "routes": [
    {
      "route": "/landlord-app*",
      "rewrite": "/landlord-app/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/chunks/*",
      "/entries/*",
      "/images/*",
      "/landlord-app/assets/*",
      "/landlord-app/landlord-app/*",
      "/*.{css,js,ico,png,jpg,jpeg,gif,svg,woff,woff2}",
      "/403.html",
      "/500.html",
      "/rate-limit-exceeded.html"
    ]
  }
}