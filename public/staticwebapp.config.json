{
  "routes": [
    {
      "route": "/landlord*",
      "rewrite": "/landlord/index.html"
    },
    {
      "route": "/billing/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/signup/*",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/chunks/*",
      "/entries/*",
      "/images/*",
      "/landlord/assets/*",
      "/landlord/landlord/*",
      "/*.{css,js,ico,png,jpg,jpeg,gif,svg,woff,woff2}",
      "/403.html",
      "/500.html",
      "/rate-limit-exceeded.html"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
