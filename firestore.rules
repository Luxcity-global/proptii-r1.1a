rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if true; // Public read access
      allow create: if isAuthenticated() && (request.auth.token.role == 'landlord' || request.auth.token.role == 'agent');
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.agentId == request.auth.uid || request.auth.token.admin == true);
    }

    // Viewing requests
    match /viewingRequests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow delete: if isAuthenticated() && 
        (resource.data.agentId == request.auth.uid || request.auth.token.admin == true);
    }

    // Search history
    match /searchHistory/{historyId} {
      allow read, write: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Test collection (for connection testing)
    match /test/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Referencing forms collection
    match /referencingForms/{documentId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // User files collection
    match /userFiles/{fileId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Book Viewing Requests collection
    match /bookViewingRequests/{documentId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.landlordId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.landlordId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
    }

    // Viewing bookings collection
    match /viewingBookings/{documentId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid || resource.data.landlordId == request.auth.uid || resource.data.agentId == request.auth.uid);
    }

    // Contract templates collection
    match /contractTemplates/{documentId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Signed contracts collection
    match /signedContracts/{documentId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Support Forms Collection
    match /supportForms/{formId} {
      // Allow anyone to create support forms (for public contact form)
      allow create: if true;
      
      // Only authenticated users (admin/support staff) can read, update, or delete
      allow read, update, delete: if isAuthenticated();
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Tenants collection
    match /tenants/{tenantId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || 
         resource.data.userId == request.auth.uid || 
         resource.data.tenantEmail == request.auth.token.email || 
         resource.data.landlordEmail == request.auth.token.email);
    }

    // Market Insights collection
    match /marketInsights/{insightId} {
      allow read: if true; // Market insights are public
      allow create, update: if isAuthenticated() && (request.auth.token.role == 'landlord' || request.auth.token.role == 'agent' || request.auth.token.admin == true);
      allow delete: if false; // Don't allow deletion (archive instead)
    }

    // Referee & Guarantor responses (submitted by external anonymous users)
    match /referee_guarantor_responses/{docId} {
      // Anyone can submit a response, but check that basic fields are present
      allow create: if request.resource.data.email != null && request.resource.data.consent != null;
      
      // Only authenticated users who are part of the transaction can read/manage
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.tenantEmail == request.auth.token.email || 
         request.auth.token.role == 'landlord' || 
         request.auth.token.role == 'agent' || 
         request.auth.token.admin == true);
    }
  }
}