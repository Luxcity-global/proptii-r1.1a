{
  "projects": {
    "default": "proptii-16946"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/landlord/assets/**",
        "destination": "/landlord/assets/**"
      },
      {
        "source": "/landlord/**",
        "destination": "/landlord/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
