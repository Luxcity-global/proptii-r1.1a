{
  "name": "survey-leads-campaign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "start": "wrangler dev --port 8787",
    "predeploy": "node -e \"require('fs').accessSync('public/campaign/index.html')\"",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply survey-leads-campaign --local",
    "db:migrate:remote": "wrangler d1 migrations apply survey-leads-campaign --remote",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  }
}
