{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "survey-leads-campaign",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "survey-leads-campaign",
      "database_id": "e7256240-dc31-4743-a089-b71b1ba94d45",
      "migrations_dir": "migrations"
    }
  ]
}
