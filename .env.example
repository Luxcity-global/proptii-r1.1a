# =============================================================================
# PROPTII FRONTEND — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# ─── Backend API URLs ─────────────────────────────────────────────────────────
# Used in: src/config/apiBaseUrl.ts, src/middleware/SecurityMiddleware.ts,
#          src/utils/apiEndpoints.ts, src/components/dashboard/sections/TenantReferencing.tsx
# The app resolves these in priority order: VITE_API_URL → VITE_NEST_API_ENDPOINT → VITE_API_ENDPOINT
VITE_API_URL=http://localhost:3000/api
VITE_NEST_API_ENDPOINT=http://localhost:3000
VITE_API_ENDPOINT=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api

# Used in: src/utils/searchBackendUrl.ts
VITE_SEARCH_BACKEND_URL=http://localhost:5000

# Set to true to force remote API even when running on localhost
# Used in: src/config/apiBaseUrl.ts
VITE_USE_REMOTE_API=false

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Used in: src/services/emailService.ts, src/components/viewings/services/emailTemplates.ts
VITE_APP_URL=http://localhost:5173

# ─── Azure AD B2C Authentication ─────────────────────────────────────────────
# Used in: src/config/authConfig.ts, src/main.tsx
VITE_AZURE_AD_CLIENT_ID=your-azure-ad-client-id
VITE_AZURE_AD_TENANT_NAME=your-tenant.onmicrosoft.com
VITE_AZURE_AD_POLICY_NAME=B2C_1_SignUpandSignInProptii
VITE_AZURE_AD_RESET_PASSWORD_POLICY_NAME=B2C_1_passwordreset
VITE_AZURE_AD_EDIT_PROFILE_POLICY_NAME=B2C_1_profileediting
# OAuth redirect URIs — used in: src/config/authConfig.ts
VITE_REDIRECT_URI=http://localhost:5173
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
# Extra scopes appended to token requests (space or comma separated) — optional
VITE_AZURE_AD_EXTRA_SCOPES=

# ─── Azure AD B2C (legacy config object) ─────────────────────────────────────
# Used in: src/config/azure.ts — isAzureConfigured() gates referencing form API calls
VITE_AZURE_AD_B2C_CLIENT_ID=your-azure-ad-client-id
VITE_AZURE_AD_B2C_AUTHORITY=https://your-tenant.b2clogin.com/your-tenant.onmicrosoft.com/B2C_1_SignUpandSignInProptii
VITE_AZURE_AD_B2C_KNOWN_AUTHORITY=your-tenant.b2clogin.com
VITE_AZURE_AD_B2C_REDIRECT_URI=http://localhost:5173
VITE_AZURE_AD_B2C_SCOPES=openid profile email

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
# Used in: src/config/azure.ts — AZURE_STORAGE object consumed by storageService.ts
# and referencing file uploads
VITE_AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
VITE_AZURE_STORAGE_CONTAINER_NAME=property-documents-landlord-agent
VITE_AZURE_STORAGE_SAS_TOKEN=your-sas-token

# ─── Firebase Client SDK ─────────────────────────────────────────────────────
# Used in: src/config/firebaseConfig.ts — initialises Firebase Auth + Firestore
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Analytics ────────────────────────────────────────────────────────
# Used in: src/utils/analytics.ts
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Azure Application Insights ──────────────────────────────────────────────
# Used in: src/utils/performanceMonitor.ts — only loaded when VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_APP_INSIGHTS_INSTRUMENTATION_KEY=your-app-insights-key

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
# Used in: src/utils/errorHandler.ts
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id
VITE_ENVIRONMENT=development

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Used in: src/components/billing/PaymentForm.tsx (publishable key)
#          src/config/plans.ts (price IDs for all plan tiers)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Renter plans
VITE_STRIPE_PRICE_RENTER_PRO_MONTHLY=price_renter_pro_monthly
VITE_STRIPE_PRICE_RENTER_PRO_ANNUAL=price_renter_pro_annual

# Buyer plans
VITE_STRIPE_PRICE_BUYER_PRO_MONTHLY=price_buyer_pro_monthly
VITE_STRIPE_PRICE_BUYER_PRO_ANNUAL=price_buyer_pro_annual

# Landlord plans
VITE_STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
VITE_STRIPE_PRICE_STARTER_ANNUAL=price_starter_annual
VITE_STRIPE_PRICE_LANDLORD_PRO_MONTHLY=price_landlord_pro_monthly
VITE_STRIPE_PRICE_LANDLORD_PRO_ANNUAL=price_landlord_pro_annual
VITE_STRIPE_PRICE_ELITE_MONTHLY=price_elite_monthly
VITE_STRIPE_PRICE_ELITE_ANNUAL=price_elite_annual

# Agent plans
VITE_STRIPE_PRICE_INDEPENDENT_MONTHLY=price_independent_monthly
VITE_STRIPE_PRICE_INDEPENDENT_ANNUAL=price_independent_annual
VITE_STRIPE_PRICE_AGENT_PRO_MONTHLY=price_agent_pro_monthly
VITE_STRIPE_PRICE_AGENT_PRO_ANNUAL=price_agent_pro_annual

# ─── Google Sheets Integration ────────────────────────────────────────────────
# Used in: src/components/ReviewModal.tsx — posts reviews to a Google Sheets webhook
VITE_GOOGLE_SHEETS_API_ENDPOINT=https://script.google.com/macros/s/your-script-id/exec

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Used in: src/components/pricing/EarlyAccessBanner.tsx — shows/hides promo banner
VITE_PROMO_FREE_MONTH_ACTIVE=false
