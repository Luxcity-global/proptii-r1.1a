# CrewAI Configuration
CREWAI_VERBOSE=true
CREWAI_MEMORY=false

# OpenAI Configuration (Demo mode - will use mock responses)
OPENAI_API_KEY=demo-key

# Anthropic Configuration (Alternative)
ANTHROPIC_API_KEY=demo-key

# Database Configuration (Optional for demo)
DATABASE_URL=sqlite:///./marketing_hub.db
REDIS_URL=memory://

# WebSocket Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8002

# Logging
LOG_LEVEL=INFO

# UK Property Market Configuration (Optional for demo)
UK_PROPERTY_API_KEY=demo-key
EPC_API_KEY=demo-key

# Demo Mode (for testing without real API keys)
DEMO_MODE=true


