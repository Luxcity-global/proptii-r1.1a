# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_ENVIRONMENT=development

# Backend Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:8182

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/marketing_hub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketing_hub
DB_USER=username
DB_PASSWORD=password

# Storage Configuration
STORAGE_PROVIDER=local
# For AWS S3:
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# For Azure Blob Storage:
AZURE_STORAGE_CONNECTION_STRING=your_connection_string
AZURE_STORAGE_CONTAINER=your_container_name

# Local Storage (default)
LOCAL_UPLOAD_PATH=./uploads
LOCAL_BASE_URL=http://localhost:3001/uploads

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AI Services (for future use)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Analytics (for future use)
GOOGLE_ANALYTICS_ID=your_ga_id
MIXPANEL_TOKEN=your_mixpanel_token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=10

# Canvas Configuration
CANVAS_MAX_OBJECTS=1000
CANVAS_AUTO_SAVE_INTERVAL=30000
CANVAS_MAX_HISTORY=50

# CDN Configuration (for production)
CDN_URL=https://cdn.yourdomain.com
CDN_CACHE_TTL=31536000

