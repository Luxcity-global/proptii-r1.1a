# =============================================================================
# .env.local — local development overrides (takes precedence over .env)
# These match the Terminal Rules startup commands.
# =============================================================================

# ─── Backend URLs (local) ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_NEST_API_ENDPOINT=http://localhost:3000
VITE_API_ENDPOINT=http://localhost:7071
VITE_SEARCH_BACKEND_URL=http://localhost:3001

# Force Vite to use the local backend even if .env points at production
VITE_USE_REMOTE_API=false
