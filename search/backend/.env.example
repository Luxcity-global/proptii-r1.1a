# ============================================================
# search/backend — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Port the scraper service listens on (default: 3001)
PORT=3001

# Brave Search API key — required. Obtain from https://brave.com/search/api/
# The key MUST NOT be hardcoded in source code.
BRAVE_API_KEY=

# Apify token for Rightmove actor (optional — leave blank if not using Apify)
APIFY_TOKEN=
APIFY_RIGHTMOVE_ACTOR_ID=
APIFY_RIGHTMOVE_TASK_ID=
APIFY_RIGHTMOVE_LOCATION_RESOLVER_URL=

# Puppeteer / Playwright browser cache paths (optional overrides)
# PUPPETEER_CACHE_DIR=
# PLAYWRIGHT_BROWSERS_PATH=
